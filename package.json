{
  "name": "gold-pasal-course",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs",
    "verify": "npm run validate:content && npm run typecheck && npm test && npm run docs:build"
  },
  "dependencies": {
    "vitepress": "^1.6.4",
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.0.8"
  }
}
